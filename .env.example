NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://greenledger:greenledger@localhost:5432/greenledger
DATABASE_SSL=false
AUTH_SECRET=replace-with-a-long-random-secret

# Required outside local development. Change all three values before deployment.
DEMO_DEVELOPER_EMAIL=developer@greenledger.local
DEMO_DEVELOPER_PASSWORD=greenledger-dev
DEMO_VERIFIER_EMAIL=verifier@greenledger.local
DEMO_VERIFIER_PASSWORD=greenledger-verify
DEMO_BENEFICIARY_EMAIL=beneficiary@greenledger.local
DEMO_BENEFICIARY_PASSWORD=greenledger-retire

# Optional: switches the CAD Trust adapter from its curated snapshot to your API endpoint.
CAD_TRUST_API_URL=
CAD_TRUST_API_TOKEN=

# Optional allow-list for real PDF retrieval, for example: registry.verra.org,kmp.catalyze.id
PDF_ALLOWED_HOSTS=
